<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="it.polimi.ingsw.client.view.gui.screen.InfoScreen" alignment="CENTER" spacing="10" style="-fx-background-color: #2b1a10; -fx-padding: 20;">
    <Label text="Reference Guide" style="-fx-font-family: 'MedievalSharp'; -fx-font-size: 24px; -fx-text-fill: #ffd700;"/>
    <TextArea fx:id="contentArea" wrapText="true" editable="false" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Courier New'; -fx-font-size: 14px;"/>
    <Button text="Chiudi" onAction="#onClose" style="-fx-font-family: 'MedievalSharp'; -fx-font-size: 18px;"/>
</VBox>