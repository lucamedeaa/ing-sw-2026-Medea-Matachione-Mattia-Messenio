<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.DropShadow?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.polimi.ingsw.client.view.gui.screen.InfoScreen"
      spacing="20" alignment="TOP_CENTER"
      style="-fx-background-color: #0d0d0d; -fx-border-color: #e67e22; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;"
      prefWidth="900" prefHeight="750">

    <padding><Insets top="25" right="30" bottom="25" left="30"/></padding>

    <Label text="CARDS REFERENCE GUIDE"
           style="-fx-font-family: 'MedievalSharp'; -fx-font-size: 32px; -fx-text-fill: #e67e22; -fx-font-weight: bold;"/>

    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="25" style="-fx-background-color: transparent;">

            <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #333; -fx-border-radius: 8;">
                <Label text="CHARACTER TYPES" style="-fx-font-family: 'MedievalSharp'; -fx-font-size: 20px; -fx-text-fill: #ffd700;"/>
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120" prefWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Builder:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #2ecc71; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Grants food discounts for buildings and prestige points at the end of the game (e.g. -1 food discount, +2 final PP)." GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Hunter:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="sym:✓ grants instant food equal to the number of Hunters in the tribe. Hunt event: grants food per Hunter in the tribe." GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Artist:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #9b59b6; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="No direct effect — scores through Cave Paintings." GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Shaman:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="★x1 / ★x2 / ★x3 ritual stars." GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Collector:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Provides a 3-food discount during the Sustenance event." GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Inventor:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #2980b9; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Has an icon — matching pairs score ONLY with InventorPair. Icons: Spearhead, Leather, Bread, Canoe, Mortar, Rope, Flute, Statue, Fishhook, Necklace." GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>
                </GridPane>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #333; -fx-border-radius: 8;">
                <Label text="EVENTS" style="-fx-font-family: 'MedievalSharp'; -fx-font-size: 20px; -fx-text-fill: #ffd700;"/>
                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="140"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Cave Paintings:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #e67e22; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Thresholds and prestige point rewards depend on the specific card." GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Hunt:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #e67e22; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Grants food based on the number of Hunters." GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Shamanic Ritual:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #e67e22; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="Players with the most stars gain PP, while players with the fewest lose PP (ties apply)." GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Sustenance:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #e67e22; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="-1 food per character (Collectors apply discounts). If food is insufficient: -N PP for each missing food." GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>
                </GridPane>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: rgba(255,255,255,0.03); -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #333; -fx-border-radius: 8;">
                <Label text="BUILDINGS" style="-fx-font-family: 'MedievalSharp'; -fx-font-size: 20px; -fx-text-fill: #ffd700;"/>
                <Label text="Buildings are purchased using food and grant prestige points at the end of the game." style="-fx-font-family: 'Arial'; -fx-text-fill: #aaa; -fx-font-size: 13px; -fx-view-order: 1;"/>

                <GridPane hgap="15" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100" prefWidth="100"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="Era 1 (3-5f):" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #61b3f5; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="RitualShield, DiverseSet, InventorPair, TurnBonus, FoodDsc(Art), FoodDsc(Col)" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;"/>

                    <Label text="Era 2 (5-7f):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #f39c12; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="ArtistFood, BuilderMastery, RitualStars, DoublePrestige, FoodDsc(Inv), SetScorer, HunterBonus" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>

                    <Label text="Era 3 (6-10f):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-family: 'Arial'; -fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Label text="VictoryPoints, LatePurchase, ClassScorer(Inv/Art/Sha/Hun/Col/Bui)" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-font-family: 'Arial'; -fx-text-fill: #fdf5e6; -fx-font-size: 14px;" wrapText="true"/>
                </GridPane>
            </VBox>

        </VBox>
    </ScrollPane>

    <Button fx:id="closeButton" text="Return to Game" onAction="#onClose" maxWidth="250"
            style="-fx-font-family: 'MedievalSharp'; -fx-background-color: rgba(15, 15, 15, 0.9); -fx-text-fill: #e67e22; -fx-font-size: 18px; -fx-border-color: #e67e22; -fx-border-width: 2; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 20;"/>

</VBox>