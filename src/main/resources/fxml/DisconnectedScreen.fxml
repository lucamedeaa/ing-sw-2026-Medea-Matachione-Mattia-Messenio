<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.polimi.ingsw.client.view.gui.screen.DisconnectedScreen"
      spacing="20" alignment="CENTER"
      prefWidth="400" prefHeight="250">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="Disconnesso dal server" styleClass="title"/>
    <Label fx:id="reasonLabel" wrapText="true" styleClass="error-label"/>
    <Button text="Esci" onAction="#onExit" maxWidth="Infinity"/>

</VBox>