<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane stylesheets="@../style/style.css"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.polimi.ingsw.client.view.gui.screen.LobbyScreen">

    <!-- Layer 1: video -->
    <StackPane fx:id="videoContainer" mouseTransparent="true"/>

    <!-- Layer 2: dark overlay for text contrast -->
    <Pane mouseTransparent="true" style="-fx-background-color: rgba(0,0,0,0.30);"/>

    <!-- Layer 3: content -->
    <BorderPane>
        <center>
            <VBox alignment="CENTER" spacing="14" BorderPane.alignment="CENTER" style="-fx-padding: 150 20 0 20;">
                <HBox maxWidth="760" minHeight="240" spacing="28" alignment="CENTER_LEFT"
                      style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 12;
                             -fx-border-color: #e67e22; -fx-border-width: 2; -fx-border-radius: 12;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 15, 0, 0, 5);">
                    <padding>
                        <Insets top="24" right="30" bottom="24" left="30"/>
                    </padding>

                    <Label text="Players in Lobby" minWidth="240"
                           style="-fx-font-family: 'MedievalSharp', serif; -fx-font-size: 34px; -fx-text-fill: #e67e22; -fx-effect: dropshadow(three-pass-box, black, 8, 0, 0, 3);"/>

                    <Separator orientation="VERTICAL"/>
                    <VBox fx:id="playersContainer" spacing="8" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label fx:id="statusLabel" wrapText="true"
                       style="-fx-font-family: 'MedievalSharp', serif; -fx-font-size: 22px; -fx-text-fill: #e67e22; -fx-effect: dropshadow(three-pass-box, black, 8, 0, 0, 3);"/>
            </VBox>
        </center>

        <bottom>
            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 0 0 40 0;">
                <HBox spacing="10" alignment="CENTER">
                    <Label text="Audio" style="-fx-font-family: 'MedievalSharp', serif; -fx-font-size: 26px; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, black, 6, 0, 0, 2);"/>
                    <Slider fx:id="volumeSlider" min="0" max="1" value="0.5" prefWidth="230"/>
                </HBox>

                <Button text="LEAVE MATCH"
                        onAction="#handleLeave"
                        prefWidth="320"
                        style="-fx-font-family: 'MedievalSharp', serif; -fx-font-size: 22px; -fx-background-color: rgba(15, 15, 15, 0.9); -fx-text-fill: #e67e22; -fx-border-color: #e67e22; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0.0, 0, 4);"/>

                <Button text="DISCONNECT"
                        onAction="#handleDisconnect"
                        prefWidth="320"
                        style="-fx-font-family: 'MedievalSharp', serif; -fx-font-size: 22px; -fx-background-color: rgba(15, 15, 15, 0.9); -fx-text-fill: #ff5252; -fx-border-color: #ff5252; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0.0, 0, 4);"/>
            </VBox>
        </bottom>
    </BorderPane>
</StackPane>