<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane stylesheets="@../style/tribal.css"
           styleClass="lobby-bg"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="it.polimi.ingsw.client.view.gui.screen.LobbyScreen">

    <BorderPane>
        <center>
            <VBox alignment="CENTER" BorderPane.alignment="CENTER"
                  style="-fx-padding: 160 0 0 0;">

                <HBox styleClass="tribal-card" maxWidth="650" minHeight="180"
                      spacing="30" alignment="CENTER_LEFT">
                    <padding><Insets top="24" right="36" bottom="24" left="36"/></padding>

                    <Label text="Giocatori in lobby"
                           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #e9c46a; -fx-min-width: 160;"/>

                    <Separator orientation="VERTICAL"/>

                    <VBox fx:id="playersContainer" spacing="8" HBox.hgrow="ALWAYS"/>

                </HBox>

                <Label fx:id="statusLabel" wrapText="true"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 13; -fx-padding: 10 0 0 0;"/>
            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" style="-fx-padding: 0 0 40 0;">
                <Button text="Abbandona partita" onAction="#handleLeave"
                        prefWidth="280" styleClass="tribal-btn-secondary"/>
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>