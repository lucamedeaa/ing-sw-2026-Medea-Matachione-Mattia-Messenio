<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.polimi.ingsw.client.view.gui.controllers.ActionsPanelController"
      spacing="8" alignment="CENTER">

    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

    <Label text="Azioni" style="-fx-font-weight: bold;"/>
    <Button fx:id="takeCardButton"   text="Pesca carta"    onAction="#handleTakeCard"   maxWidth="Infinity" disable="true"/>
    <Button fx:id="placeTotemButton" text="Piazza totem"   onAction="#handlePlaceTotem" maxWidth="Infinity" disable="true"/>
    <Button fx:id="skipButton"       text="Salta azione"   onAction="#handleSkip"       maxWidth="Infinity" disable="true"/>

</VBox>