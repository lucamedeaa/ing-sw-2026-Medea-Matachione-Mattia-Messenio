<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="it.polimi.ingsw.client.view.gui.controllers.TribePanelController"
      styleClass="tribe-container" VBox.vgrow="ALWAYS">

    <padding><Insets top="10" right="15" bottom="10" left="15"/></padding>

    <Label fx:id="tribeOwnerLabel" text="LA TUA TRIBÙ" styleClass="panel-title"/>

    <ScrollPane fitToHeight="true" pannable="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
        <HBox fx:id="cardsContainer" spacing="15" alignment="CENTER_LEFT" styleClass="cards-hbox"/>
    </ScrollPane>

</VBox>